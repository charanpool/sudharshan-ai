{
    "Comment": "Sudharshan-AI: Silent Circuit Breaker Workflow",
    "StartAt": "DetermineAction",
    "States": {
        "DetermineAction": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.decision",
                    "StringEquals": "hold",
                    "Next": "HoldAndAlert"
                },
                {
                    "Variable": "$.decision",
                    "StringEquals": "delay",
                    "Next": "ApplyCoolingPeriod"
                }
            ],
            "Default": "Success"
        },
        "HoldAndAlert": {
            "Type": "Parallel",
            "Branches": [
                {
                    "StartAt": "SendSilentAlert",
                    "States": {
                        "SendSilentAlert": {
                            "Type": "Task",
                            "Resource": "arn:aws:lambda:us-east-1:123456789012:function:AlertHandler",
                            "End": true
                        }
                    }
                },
                {
                    "StartAt": "InitiateManualReview",
                    "States": {
                        "InitiateManualReview": {
                            "Type": "Wait",
                            "Seconds": 1800,
                            "Next": "FinalDecision"
                        },
                        "FinalDecision": {
                            "Type": "Pass",
                            "Result": "Manual review timeout - Escalating",
                            "End": true
                        }
                    }
                }
            ],
            "Next": "Success"
        },
        "ApplyCoolingPeriod": {
            "Type": "Wait",
            "Seconds": 300,
            "Next": "Success"
        },
        "Success": {
            "Type": "Succeed"
        }
    }
}